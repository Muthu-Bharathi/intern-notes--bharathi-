# Copy this file to .env and fill in real values. .env is git-ignored - never commit it.

# MySQL root password (can also be a Windows environment variable instead)
DB_PASSWORD=

# Keycloak (identity provider) - issues the JWTs this app validates
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/community-library
KEYCLOAK_CLIENT_ID=community-library-app

# Keycloak admin console login (http://localhost:8180) - used by keycloak.cmd
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

# First-login password for new librarians / members created with an empty password (default Welcome@123)
DEFAULT_USER_PASSWORD=Welcome@123
# Seconds the default password works before it must have been changed (default 120)
TEMP_PASSWORD_VALIDITY_SECONDS=120
KEYCLOAK_SERVER_URL=http://localhost:8180

# Folder of the unzipped Keycloak server - used by keycloak.cmd. Use / not \ in the path
KEYCLOAK_HOME=
